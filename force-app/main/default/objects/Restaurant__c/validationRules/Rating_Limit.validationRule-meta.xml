<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rating_Limit</fullName>
    <active>true</active>
    <description>Rating must be between 0 and 5</description>
    <errorConditionFormula>OR(
Rating__c &gt; 5,
Rating__c &lt; 0
)</errorConditionFormula>
    <errorMessage>Rating must be between 0 and 5</errorMessage>
</ValidationRule>
