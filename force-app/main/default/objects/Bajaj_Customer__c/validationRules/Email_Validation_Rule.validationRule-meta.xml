<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Email_Validation_Rule</fullName>
    <active>true</active>
    <errorConditionFormula>NOT( CONTAINS( Customer_Email__c , &quot;@gmail&quot;) )</errorConditionFormula>
    <errorDisplayField>Customer_Email__c</errorDisplayField>
    <errorMessage>Provide valid email address</errorMessage>
</ValidationRule>
