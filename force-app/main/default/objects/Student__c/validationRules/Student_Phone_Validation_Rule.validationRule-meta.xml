<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Student_Phone_Validation_Rule</fullName>
    <active>true</active>
    <description>phone number must be equal to 10 digits only.</description>
    <errorConditionFormula>LEN( Student_Phone__c )  &lt;&gt; 10</errorConditionFormula>
    <errorDisplayField>Student_Phone__c</errorDisplayField>
    <errorMessage>phone no. must be 10 digits</errorMessage>
</ValidationRule>
